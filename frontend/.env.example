# Endereço da API em produção. Em desenvolvimento deixe vazio: o Vite reencaminha /api para o backend.
# O painel /admin usa o mesmo login da loja, por isso já não precisa de chaves do Supabase aqui.
VITE_API_URL=

# Login social (opcional). Os mesmos IDs devem estar no .env do backend.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
