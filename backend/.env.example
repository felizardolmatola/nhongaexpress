# =============================================================================
# NhongaExpress backend — variáveis de ambiente (NÃO enviar para o Git)
# =============================================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Endereço do frontend autorizado a chamar a API (CORS). Vite usa a porta 5173.
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings > API) ---
# SUPABASE_URL: "Project URL". SERVICE_ROLE_KEY: chave "service_role" (secreta!).
# Esta chave ignora o RLS: usar APENAS aqui no backend, nunca no frontend.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# --- JWT ---
# Segredo usado para assinar os tokens (mín. 32 caracteres). Este foi gerado
# aleatoriamente para si; para gerar outro: openssl rand -hex 48
JWT_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
# Duração da sessão quando "Manter sessão iniciada" está marcado.
JWT_EXPIRES_IN=7d
# Duração quando NÃO está marcado (o cookie também expira ao fechar o navegador).
JWT_SHORT_EXPIRES_IN=12h

# --- Cookie da sessão ---
# lax: front e API no mesmo site (ex.: localhost, ou app.exemplo.com + api.exemplo.com).
# none: front e API em domínios diferentes (exige HTTPS; ver README).
COOKIE_SAMESITE=lax

# --- Proxy ---
# Número de proxies à frente da API (ex.: 1 em Render/Railway/Nginx); 0 em local.
TRUST_PROXY=0

# --- Recuperação de palavra-passe: envio do código (opcional em desenvolvimento) ---
# Sem SMTP/SMS configurados, o código aparece na CONSOLA do servidor (só com NODE_ENV=development).
# E-mail (SMTP): ex. Gmail com "palavra-passe de app", Brevo, Mailgun, Resend (SMTP)...
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NhongaExpress <no-reply@seudominio.com>
# SMS (contas só com telefone): o backend faz POST {"to":"+25884...","message":"..."} a este URL.
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# O administrador é uma conta normal da loja com role = 'admin' (npm run admin:promote). Nunca coloque palavras-passe aqui.

# --- Login social (opcional: sem isto, /api/auth/google e /api/auth/apple respondem 503) ---
# Google: "ID de cliente OAuth" (Aplicação Web). Apple: o "Services ID" (ex.: com.nhongaexpress.web).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
